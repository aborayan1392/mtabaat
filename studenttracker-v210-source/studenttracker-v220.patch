+    public int moveStudent(long studentId, String newGrade, String newSection) {
+        SQLiteDatabase db = getWritableDatabase();
+        db.beginTransaction();
+        try {
+            String grade = safe(newGrade).trim();
+            String section = safe(newSection).trim();
+            ContentValues v = new ContentValues();
+            v.put("grade", nullIfBlank(grade));
+            v.put("section", nullIfBlank(section));
+            v.put("display_order", nextStudentOrder(db, grade, section));
+            int updated = db.update("students", v, "_id=? AND active=1", new String[]{String.valueOf(studentId)});
+            if (updated > 0) renumberStudents(db);
+            db.setTransactionSuccessful();
+            return updated;
+        } finally {
+            db.endTransaction();
+        }
+    }
