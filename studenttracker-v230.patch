+            db.delete("behavior_records", null, null);
+            db.delete("assessments", null, null);
+            db.delete("student_reminders", null, null);
+            db.delete("class_sessions", null, null);
+            db.delete("students", null, null);
+            db.delete("statuses", null, null);
+            db.delete("school_settings", null, null);
+
+            // إعادة العدادات الداخلية حتى يبدأ التطبيق فعلياً من الصفر.
+            try {
+                db.execSQL("DELETE FROM sqlite_sequence WHERE name IN ('students','statuses','followups','class_sessions','guardian_contacts','behavior_records','assessments','student_reminders')");
+            } catch (Exception ignored) {}
+
+            insertDefaultStatuses(db);
+            db.setTransactionSuccessful();
+        } finally {
+            db.endTransaction();
+        }
+    }
