+    public void resetAllData() {
+        SQLiteDatabase db = getWritableDatabase();
+        db.beginTransaction();
+        try {
+            // نحذف الجداول التابعة أولاً ثم الأساسية للحفاظ على سلامة المفاتيح الخارجية.
+            db.delete("followups", null, null);
