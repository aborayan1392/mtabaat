+    private void showFinalResetDialog() {
+        LinearLayout wrap=UiUtils.vertical(this);
+        wrap.setPadding(UiUtils.dp(this,18),0,UiUtils.dp(this,18),0);
+        TextView note=UiUtils.text(this,"للتأكيد النهائي اكتب كلمة «تهيئة» في الحقل التالي.",13,Color.parseColor("#6D3A36"),true);
+        note.setGravity(Gravity.RIGHT);
+        EditText confirm=field("اكتب: تهيئة");
+        wrap.addView(note);
+        wrap.addView(confirm);
+        AlertDialog dialog=new AlertDialog.Builder(this)
+                .setTitle("تأكيد نهائي")
+                .setView(wrap)
+                .setPositiveButton("حذف جميع البيانات",null)
+                .setNegativeButton("إلغاء",null)
+                .create();
+        dialog.setOnShowListener(x -> {
+            dialog.getButton(AlertDialog.BUTTON_POSITIVE).setTextColor(Color.parseColor("#B3261E"));
+            dialog.getButton(AlertDialog.BUTTON_POSITIVE).setOnClickListener(v -> {
+                String value=confirm.getText().toString().trim();
+                if(!"تهيئة".equals(value)){
+                    confirm.setError("اكتب كلمة تهيئة كما هي");
+                    return;
+                }
+                dialog.dismiss();
+                resetApplication();
+            });
+        });
+        dialog.show();
+    }
+
+    private void resetApplication() {
+        try {
+            db.resetAllData();
+            logoUri=null;
+            Toast.makeText(this,"تمت تهيئة التطبيق بالكامل",Toast.LENGTH_LONG).show();
+            Intent i=new Intent(this,MainActivity.class);
+            i.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK|Intent.FLAG_ACTIVITY_CLEAR_TASK);
+            startActivity(i);
+            finish();
+        } catch(Exception e) {
+            Toast.makeText(this,"تعذر تهيئة التطبيق: "+e.getMessage(),Toast.LENGTH_LONG).show();
+        }
+    }
